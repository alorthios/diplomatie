# Mot de passe de la base (obligatoire) — générez-en un : openssl rand -base64 24
POSTGRES_PASSWORD=changez-moi

# Port exposé sur l'hôte
HTTP_PORT=3000

# Derrière un reverse proxy HTTPS (Caddy, Traefik, nginx…) : passez les deux à true
COOKIE_SECURE=false
TRUST_PROXY=false

# Fermez les inscriptions une fois vos joueurs inscrits
ALLOW_REGISTRATION=true

# Image publiée (sinon construite localement), ex. ghcr.io/proprietaire/diplomatie:1.0.0
# APP_IMAGE=ghcr.io/proprietaire/diplomatie:latest

TZ=Europe/Paris
